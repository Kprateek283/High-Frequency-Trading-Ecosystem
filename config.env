# One config source for the whole ecosystem: bash sources it, C++ getenv()s it,
# Python reads os.environ. Defaults live in code; anything set here overrides.
# KEY=value only — no quoting, no expansion; this file is both sourced by bash
# and parsed line-by-line by other consumers.

# --- Network endpoints ---
TCP_PORT=9091                 # exchange order-entry gateway (OUCH/TCP)
MULTICAST_GROUP=239.255.0.1   # market-data (ITCH) multicast group
MULTICAST_PORT=12345          # market-data multicast port

# --- Engine topology ---
NUM_SHARDS=4                  # matching-engine shards (compile-time in exchange.cpp)
GATEWAY_THREADS=4             # SO_REUSEPORT gateway workers (read by exchange + firm)

# --- CPU core map ---
# Comma-separated, indexed by worker/shard number. Gateway workers pin per 3.2.
#
# This map is specific to the dev box (Alder Lake i5-1240P, docs/machine-profile.md):
# CPUs 0-7 are four SMT *pairs* on four P-cores (4400 MHz); CPUs 8-15 are eight
# E-cores (3300 MHz), no SMT. `lscpu -e=CPU,CORE,MAXMHZ` is the source of truth --
# MAXMHZ is the only reliable P/E discriminator, since under a scaling governor
# the *current* clocks make E-cores look like throttled P-cores.
#
# There are 8 hot threads and only 4 physical P-cores, so SMT sharing is forced.
# The pairing is therefore chosen rather than inherited: engine_i and gateway_i
# land on the two siblings of one physical core, so the SPSC handoff between them
# stays in a shared L1/L2 instead of crossing cores.
#
#   core 0 (cpu 0,1)  engine0 + gateway0
#   core 1 (cpu 2,3)  engine1 + gateway1
#   core 2 (cpu 4,5)  engine2 + gateway2
#   core 3 (cpu 6,7)  engine3 + gateway3
#   cores 4-6 (cpu 8,9,10)  publisher, order_manager, dispatcher -- cold, off the P-cores
#
# The previous map was ENGINE_CORES=2,4,6,8 / AUX_CORES=0,9. That ran off the end
# of the P-cores, so shard 3 alone sat on a 3300 MHz E-core, and the odd/even split
# paired each shard with a *stranger* gateway worker rather than its own producer.
#
# Anything pinning to cpu >= 8 needs EXCHANGE_CPUSET to cover it: the throughput
# harness runs the exchange under `taskset -c $EXCHANGE_CPUSET`, and an affinity
# request outside that mask fails.
GATEWAY_CORES=1,3,5,7        # one per gateway worker  (live: read in worker_loop)
ENGINE_CORES=0,2,4,6         # one per engine shard    (live: read in exchange.cpp main)
AUX_CORES=8,9,10             # [0]=publisher [1]=order_manager [2]=dispatcher

# --- Paths ---
AUDIT_LOG_PATH=order_audit.log        # engine writes; monitor tails (reserved)
STATS_SHM_PATH=/dev/shm/hft_stats     # Phase 4 seqlock stats region (reserved)
FIRM_STATS_SHM_PATH=                  # firm seqlock region override; blank => /dev/shm/firm_stats_<FIRM_ID>
